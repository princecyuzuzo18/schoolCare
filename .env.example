# ---------------------------------------------------------------------------
# SCHOOLCARE AI ASSISTANT (optional; server-side only)
# Leave the key as the placeholder below to keep the assistant unavailable.
# A real key must be a Google Gemini API key and must never be exposed to the browser.
# ---------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Supported provider. Only "gemini" is implemented; never switch to a paid provider automatically.
AI_PROVIDER="gemini"
# Preferred model variable. gemini-3.5-flash-lite is a current low-cost model;
# confirm it appears under the Free tier for your project in Google AI Studio.
GEMINI_MODEL="gemini-3.5-flash-lite"
# Legacy fallback used only when GEMINI_MODEL is empty.
AI_MODEL="gemini-3.5-flash-lite"
# Set to "false" to disable the assistant without removing the key.
AI_ENABLED="true"
# Default response language when a request does not specify one: "en" or "rw".
AI_DEFAULT_LANGUAGE="en"
# Provider timeout in milliseconds (2000-120000; default 25000).
AI_TIMEOUT_MS="25000"
# Maximum AI chat requests per user per hour (1-10000; default 60).
AI_RATE_LIMIT_PER_HOUR="60"
# Conversation/message retention in days (1-3650; default 180).
AI_RETENTION_DAYS="180"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# PUBLIC_SITE_URL: Public canonical origin for the school website.
# Used for canonical links, Open Graph URLs, sitemap.xml and structured data.
# Set this to the real HTTPS domain before deployment.
PUBLIC_SITE_URL="https://school.example.rw"

# NODE_ENV: set to "production" on the live server. This enables Secure session
# cookies (HTTPS required), production static asset serving and HSTS headers.
NODE_ENV="development"

# PORT: Local port used by the SchoolCare server behind the reverse proxy
PORT=3010

# TRUST_PROXY: Number of trusted reverse-proxy hops (1 behind Nginx/Caddy).
# Leave at 0 when the Node process is directly exposed; otherwise req.ip can
# be spoofed through X-Forwarded-For.
TRUST_PROXY=0

# ALLOW_DEMO_RESET: Enable destructive demo reset only on disposable environments
ALLOW_DEMO_RESET="false"

# ---------------------------------------------------------------------------
# MARIADB DATABASE CONFIGURATION (local Zorin OS installation)
# Create schoolcare_db + schoolcare_user first (see mysql/README_ZORIN.md).
# Never use the MariaDB root account here. The legacy aliases DB_USERNAME and
# DB_DATABASE are still accepted by the backend for compatibility.
# ---------------------------------------------------------------------------
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="schoolcare_db"
DB_USER="schoolcare_user"
DB_PASSWORD="CHANGE_ME"
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=5000
DB_QUEUE_LIMIT=10

# NOTIFICATION GATEWAYS (Rwanda / East Africa telecom integrations)
# SMS Gateway: Africa's Talking, Twilio, or MTN/Airtel Rwanda SMS Gateway
SMS_GATEWAY_PROVIDER="africastalking"
SMS_API_KEY=""
SMS_SENDER_ID="SchoolCare"

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Email SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="notifications@schoolcare.rw"

# ADMISSIONS (public Apply Here portal)
# Reference/OTP signing secret — REQUIRED in production (minimum 32 characters).
# Generate with: openssl rand -hex 32
ADMISSION_TRACKING_SECRET=""
# Email addresses that receive a notification for every new application (comma separated)
ADMISSIONS_NOTIFICATION_EMAILS=""
# Generic HTTPS SMS webhook. Leave empty to disable SMS (no delivery is simulated).
# The gateway receives JSON: { to, message, senderId } with a Bearer API key.
SMS_GATEWAY_URL=""
# Optional: directory for uploaded documents. Kept outside public/ by default.
ADMISSION_UPLOAD_DIR=""
