# GEMINI_API_KEY: Optional server-side AI assistant (never exposed to the client)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# APP_PORT: Local development port used by the SchoolCare server
PORT=3010

# ALLOW_DEMO_RESET: Enable destructive demo reset only on disposable environments
ALLOW_DEMO_RESET="false"

# MYSQL & XAMPP DATABASE CONFIGURATION (Default XAMPP setup: user 'root' with empty password)
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="schoolcare_db"

# NOTIFICATION GATEWAYS (Rwanda / East Africa telecom integrations)
# SMS Gateway: Africa's Talking, Twilio, or MTN/Airtel Rwanda SMS Gateway
SMS_GATEWAY_PROVIDER="africastalking"
SMS_API_KEY=""
SMS_SENDER_ID="SchoolCare"

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Email SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="notifications@schoolcare.rw"
